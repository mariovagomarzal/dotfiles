{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "nix develop --command true >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "nix fmt >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ]
  }
}
