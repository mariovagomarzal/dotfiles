---
export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const shown = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside>
  {
    shown.length > 0 && (
      <nav aria-label="On this page">
        <h2>On this page</h2>
        <ul>
          {shown.map((h) => (
            <li class={`depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</aside>

<style>
  aside {
    display: none;
  }

  @media (min-width: 80rem) {
    aside {
      display: block;
      position: sticky;
      top: var(--bar);
      height: calc(100vh - var(--bar));
      overflow-y: auto;
      padding: 2.5rem 1.25rem 2rem 0;
    }
  }

  h2 {
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  ul {
    list-style: none;
    padding: 0;
    font-size: var(--size-sm);
  }

  li + li {
    margin-top: 0.3rem;
  }

  ul {
    border-left: 1px solid var(--color-border);
  }

  a {
    display: block;
    margin-left: -1px;
    padding-left: 0.75rem;
    border-left: 2px solid transparent;
    color: var(--color-muted);
    text-decoration: none;
  }

  .depth-3 a {
    padding-left: 1.5rem;
  }

  a:hover {
    color: var(--color-text);
  }

  a[aria-current] {
    color: var(--color-text);
    border-left-color: var(--color-accent);
  }
</style>

<script>
  // Marks the section being read: the last heading that has scrolled past the top bar, or the last one once the page
  // can scroll no further.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="On this page"] a')];
  const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
  const bar = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--bar")) * 16;

  let queued = false;
  const update = () => {
    queued = false;
    const line = bar() + 32;
    let current = 0;
    targets.forEach((t, i) => {
      if (t && t.getBoundingClientRect().top <= line) current = i;
    });
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) current = targets.length - 1;
    links.forEach((a, i) => (i === current ? a.setAttribute("aria-current", "location") : a.removeAttribute("aria-current")));
  };

  if (links.length) {
    addEventListener("scroll", () => {
      if (!queued) requestAnimationFrame(update);
      queued = true;
    });
    update();
  }
</script>
