---
import { type Commit, commitUrl, moduleNames } from "../lib/repo";
import { path } from "../paths";

interface Props {
  commits: Commit[];
  /** Show the date beside each commit; a release already dates its own. */
  dated?: boolean;
}

const { commits, dated = true } = Astro.props;
---

<ol class="history">
  {
    commits.map((c) => {
      const row = (
        <>
          {dated && <time>{c.date}</time>}
          <span class="kind">{c.type && <span class="tag">{c.type}</span>}</span>
          <span class="subject">
            {c.scope &&
              (moduleNames.has(c.scope) ? (
                <a class="scope" href={path(`/modules/${c.scope}`)}>
                  {c.scope}
                </a>
              ) : (
                <span class="scope other">{c.scope}</span>
              ))}
            {c.description}
          </span>
          <a class="hash" href={commitUrl(c.hash)}>
            {c.hash.slice(0, 7)}
          </a>
        </>
      );
      return (
        <li class={dated ? "dated" : undefined}>
          {c.body ? (
            <details>
              <summary class="row">{row}</summary>
              <p class="body">{c.body}</p>
            </details>
          ) : (
            <div class="row">{row}</div>
          )}
        </li>
      );
    })
  }
</ol>

<style>
  .history {
    list-style: none;
    padding: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    font-size: var(--size-sm);
  }

  li + li {
    border-top: 1px solid var(--color-border);
  }

  .row {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.45rem 0.75rem;
  }

  .dated .row {
    grid-template-columns: 5.75rem 4.5rem 1fr auto;
  }

  summary.row {
    cursor: pointer;
    list-style: none;
  }

  summary.row::-webkit-details-marker {
    display: none;
  }

  summary.row:hover,
  details[open] > summary.row {
    background: var(--color-base);
  }

  /* A commit with a message to read is marked by its subject, not by a disclosure triangle. */
  summary .subject {
    text-decoration: underline dotted var(--color-muted);
    text-underline-offset: 0.25em;
  }

  time,
  .hash,
  .scope {
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    color: var(--color-muted);
  }

  .scope {
    margin-right: 0.5rem;
    color: var(--color-accent);
  }

  .scope.other {
    color: var(--color-muted);
  }

  .hash {
    text-decoration: none;
  }

  .hash:hover {
    color: var(--color-accent);
  }

  /* Commit bodies are wrapped by hand, so their own line breaks are dropped and the column decides. */
  .body {
    padding: 0.5rem 0.75rem 0.75rem 1.5rem;
    background: var(--color-base);
    border-left: 2px solid var(--color-accent);
    color: var(--color-muted);
  }

  @media (max-width: 40rem) {
    .row,
    .dated .row {
      grid-template-columns: auto 1fr auto;
    }

    .dated time {
      grid-column: 1 / -1;
    }
  }
</style>
