---
import { type Commit } from "../lib/repo";
import History from "./History.astro";

interface Props {
  commits: Commit[];
}

const { commits } = Astro.props;
const [latest] = commits;
---

{
  latest ? (
    <details class="timeline" data-pagefind-ignore>
      <summary>
        <span class="count">
          {commits.length} {commits.length === 1 ? "commit" : "commits"}
        </span>
        <span class="latest">
          Last changed on {latest.date}: {latest.description}
        </span>
        <span class="toggle" />
      </summary>
      <History commits={commits} />
    </details>
  ) : (
    <p class="muted">No commits yet.</p>
  )
}

<style>
  summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 0.6rem 0.9rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    font-size: var(--size-sm);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    border-color: var(--color-accent);
  }

  .count {
    font-family: var(--font-mono);
    font-size: var(--size-xs);
  }

  .latest {
    flex: 1;
    color: var(--color-muted);
  }

  .toggle::after {
    content: "Show all";
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    color: var(--color-accent);
  }

  details[open] .toggle::after {
    content: "Hide";
  }

  details[open] > summary {
    margin-bottom: 0.5rem;
  }
</style>
